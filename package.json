{
  "name": "snecko",
  "version": "0.7.0",
  "private": true,
  "description": "Snake + Roguelike game",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/ tests/",
    "lint:fix": "oxlint --fix src/ tests/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run test",
    "play": "node src/main.terminal.js",
    "serve": "npx --yes serve .",
    "upload:build": "bun build ./index.html --outdir ./dist --production --minify && cp -R assets dist/assets",
    "upload:serve": "npx --yes serve ./dist"
  },
  "devDependencies": {
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "vitest": "^3.0.0"
  }
}
